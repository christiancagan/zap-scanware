# MalwareShield dashboard backend configuration
PORT=8080
# Persist the JSON store here (defaults to server/data/store.json)
# DATA_FILE=/var/lib/malwareshield/store.json
ORG_NAME=Default
# Bootstrap owner admin (created only when no admins exist). Min 12 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-1234
# Set in production so the session cookie is marked Secure (requires HTTPS)
NODE_ENV=development
